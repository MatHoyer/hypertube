{
  "name": "server",
  "scripts": {
    "clear": "rm -rf node_modules dist",
    "dev": "nodemon --watch src --watch ../../packages/server-core/src --watch ../../packages/libs/src --ext ts --exec 'tsx src/main.ts'",
    "build": "tsc && cp -r src/emails/default-email.html dist/apps/server/src/emails",
    "start": "node dist/apps/server/src/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@hono/swagger-ui": "^0.6.1",
    "@hypertube/libs": "workspace:*",
    "@hypertube/server-core": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "adm-zip": "^0.6.0",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.3.7",
    "hono": "^4.12.18",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.1",
    "sharp": "^0.35.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.1",
    "@types/adm-zip": "^0.5.7",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.0",
    "nodemon": "^3.1.14",
    "testcontainers": "^12.0.1",
    "tsx": "^4.7.1",
    "vitest": "^4.1.7"
  }
}
