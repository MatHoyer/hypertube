{
  "name": "hypertube",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "//-- Cleaning --": "",
    "clear": "rm -rf node_modules && pnpm -r clear",
    "//-- Client --": "",
    "dev:client": "pnpm -r --parallel --filter 'client...' dev",
    "build:client": "pnpm -r --filter 'client...' build",
    "//-- Server --": "",
    "dev:server": "pnpm -r --parallel --filter 'server...' dev",
    "build:server": "pnpm -r --filter 'server...' build",
    "start:server": "pnpm --filter server start",
    "//-- Downloader --": "",
    "dev:downloader": "pnpm -r --parallel --filter 'downloader...' dev",
    "build:downloader": "pnpm -r --filter 'downloader...' build",
    "start:downloader": "pnpm --filter downloader start",
    "//-- Scheduler --": "",
    "dev:scheduler": "pnpm -r --parallel --filter 'scheduler...' dev",
    "build:scheduler": "pnpm -r --filter 'scheduler...' build",
    "start:scheduler": "pnpm --filter scheduler start",
    "//-- Subtitle Proxy --": "",
    "dev:subtitle-proxy": "pnpm -r --parallel --filter 'subtitle-proxy...' dev",
    "build:subtitle-proxy": "pnpm -r --filter 'subtitle-proxy...' build",
    "start:subtitle-proxy": "pnpm --filter subtitle-proxy start",
    "//-- Build pacakges --": "",
    "build:libs": "pnpm --filter libs build",
    "build:server-core": "pnpm --filter server-core build",
    "build:packages": "pnpm build:libs && pnpm build:server-core",
    "//-- without proxy --": "",
    "dev:without-proxy": "pnpm build:packages && pnpm -r --parallel --filter !subtitle-proxy dev",
    "build:without-proxy": "pnpm build:packages && pnpm -r --parallel --filter !subtitle-proxy build",
    "start:without-proxy": "pnpm -r --parallel --filter !subtitle-proxy start",
    "//-- All --": "",
    "dev": "pnpm build:packages && pnpm -r --parallel dev",
    "build": "pnpm build:packages && pnpm -r --parallel build",
    "start": "pnpm -r --parallel start",
    "//-- Testing --": "",
    "test": "pnpm --filter server test",
    "test:server": "pnpm --filter server test",
    "//-- Linting --": "",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "bullmq>ioredis": "$ioredis",
      "zod": "4.5.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "bullmq": "^5.77.2",
    "date-fns": "^4.3.0",
    "i18next": "^26.3.0",
    "ioredis": "^5.11.1",
    "zod": "^4.4.3"
  }
}
